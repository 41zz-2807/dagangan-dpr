# ==========================================================
# Dagang POS - contoh konfigurasi. SALIN ke .env lalu isi.
# JANGAN commit .env (sudah masuk .gitignore).
# ==========================================================

# --- PostgreSQL (container dagang-db, TIDAK dipublish ke host) ---
POSTGRES_USER=dagang
POSTGRES_PASSWORD=ganti-password-postgres-kuat
POSTGRES_DB=dagang

# --- Keamanan ---
# SECRET_KEY: string panjang acak. Generate: python3 -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=ganti-dengan-kunci-acak-yang-panjang-dan-rahasia
# Akun owner pertama (dibuat otomatis saat container start)
OWNER_USERNAME=owner
OWNER_PASSWORD=ganti-password-owner-kuat

# --- URL publik (dipakai untuk link struk absolut) ---
BASE_URL=https://dagangan.smart-plus.id

# --- Identitas toko (dicetak di struk) ---
STORE_NAME="Toko Dagang"
STORE_ADDRESS=Jl. Contoh No. 1, Jakarta
STORE_PHONE=0812-0000-0000
STORE_FOOTER="Terima kasih telah berbelanja!"

# --- Jaringan eksternal milik container cloudflared ---
# Nama network tempat container `tunnel-cloudflared` berada.
CLOUDFLARED_NETWORK=war-nt-web_default

# --- Zona waktu ---
TZ=Asia/Jakarta

# --- Opsional (nilai default sudah aman) ---
# number = jumlah worker gunicorn, thread per worker
GUNICORN_WORKERS=3
GUNICORN_THREADS=4
# auto | true | false  (auto: cookie Secure mengikuti skema request)
COOKIE_SECURE=auto
# Login: jumlah percobaan gagal per username sebelum dikunci sementara
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=10
# Ukuran maksimum upload gambar (MB)
MAX_UPLOAD_MB=8
# --- Email struk (fitur tahap akhir, dimatikan secara default) ---
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
